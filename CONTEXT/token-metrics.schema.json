{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TokenMetrics",
  "type": "object",
  "required": [
    "run_id",
    "route",
    "compiled_estimate",
    "cache_hits",
    "expansions",
    "duplicate_ratio"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "compiled_estimate": {
      "type": "integer",
      "minimum": 0
    },
    "provider_input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "provider_output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cache_hits": {
      "type": "integer",
      "minimum": 0
    },
    "expansions": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "task_result": {
      "type": [
        "string",
        "null"
      ]
    },
    "qa_verdict": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
