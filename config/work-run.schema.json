{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mozare.local/schemas/work-run.schema.json",
  "title": "Mozare Workbench Durable Work Run",
  "type": "object",
  "required": ["schemaVersion", "runId", "projectId", "missionId", "taskId", "taskVersion", "supersedesRunId", "harness", "model", "effort", "capabilitySnapshotRef", "contextPackRef", "contextSnapshotRef", "authorityRefs", "oracleRefs", "candidateBefore", "candidateAfter", "status", "resultSummary", "changedRefs", "evidenceRefs", "decisions", "blockers", "remaining", "nextAction", "handoffRef", "operatorRole", "startedAt", "endedAt", "recordedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/id" },
    "projectId": { "$ref": "#/$defs/id" },
    "missionId": { "$ref": "#/$defs/id" },
    "taskId": { "$ref": "#/$defs/id" },
    "taskVersion": { "type": "integer", "minimum": 1 },
    "supersedesRunId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "harness": { "enum": ["claude", "codex", "hermes", "manual", "fake"] },
    "model": { "type": ["string", "null"] },
    "effort": { "type": ["string", "null"] },
    "capabilitySnapshotRef": { "type": "string", "minLength": 1 },
    "contextPackRef": { "type": "string", "minLength": 1 },
    "contextSnapshotRef": { "type": ["string", "null"] },
    "authorityRefs": { "$ref": "#/$defs/refs" },
    "oracleRefs": { "$ref": "#/$defs/refs" },
    "candidateBefore": { "type": ["string", "null"] },
    "candidateAfter": { "type": ["string", "null"] },
    "status": { "enum": ["queued", "running", "needs_input", "interrupted", "parked", "completed", "failed", "superseded"] },
    "resultSummary": { "type": "string", "minLength": 1, "maxLength": 800 },
    "changedRefs": { "$ref": "#/$defs/refs" },
    "evidenceRefs": { "$ref": "#/$defs/refs" },
    "decisions": { "$ref": "#/$defs/refs" },
    "blockers": { "$ref": "#/$defs/refs" },
    "remaining": { "$ref": "#/$defs/refs" },
    "nextAction": { "type": "string", "minLength": 1, "maxLength": 500 },
    "handoffRef": { "type": ["string", "null"] },
    "operatorRole": { "enum": ["owner", "agent", "reviewer", "system"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": ["string", "null"], "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "refs": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } }
  }
}
