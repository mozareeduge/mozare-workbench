{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mozare.local/schemas/task-card.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cards"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "objective",
          "required_reads",
          "create_or_modify",
          "must_preserve",
          "implementation_steps",
          "tests",
          "done_when",
          "stop_if",
          "handoff"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^TASK-P[0-9]{2}-[0-9]{2}$"
          },
          "objective": {
            "type": "string",
            "minLength": 5
          },
          "required_reads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "create_or_modify": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "must_preserve": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "implementation_steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^TEST-(?:[0-9]{3}|(?:CTX|TOK|GUI|MET)-[0-9]{2})$"
            }
          },
          "done_when": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "stop_if": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "handoff": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
